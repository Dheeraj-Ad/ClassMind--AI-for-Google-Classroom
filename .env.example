# Choose local_evidence (offline) or gemini (question/excerpts sent to Google).
ANSWER_PROVIDER=local_evidence
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_OUTPUT_TOKENS=1400
IMPORT_WORKERS=1
AUTO_IMPORT_COURSES=false
EMBEDDING_THREADS=2
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
GOOGLE_CREDENTIALS_FILE=backend/auth/credentials.json
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
BACKEND_URL=http://localhost:8000
PUBLIC_BACKEND_URL=http://localhost:8000
STREAMLIT_URL=http://localhost:8501
DATA_DIR=data
COOKIE_SECURE=false
SESSION_DAYS=7
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_TOKENS=900
CHUNK_OVERLAP=150
RETRIEVAL_K=6
# Cosine similarity cutoff; calibrate against your own course questions.
MIN_SIMILARITY=0.32
MAX_DOWNLOAD_MB=200
MAX_EXTRACTED_CHARS=2000000
YOUTUBE_LANGUAGES=en,hi
